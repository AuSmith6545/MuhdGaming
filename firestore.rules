rules_version = '2';

// The friend allowlist itself lives in Firestore's `friends` collection
// (doc ID = the friend's email), NOT in this file — so no one's email
// address ever ends up in git, public repo or not. Manage that collection
// by hand in Firebase Console -> Firestore Database -> Data tab.
//
// Whenever you change the rules below, copy/paste this whole file into:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function isFriend() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/friends/$(request.auth.token.email));
    }

    // An admin is just a friend doc with isAdmin: true — set by hand in the
    // console (on your own doc: Firestore Database -> Data -> friends ->
    // your email -> add field isAdmin (boolean) = true). Not hardcoded here,
    // for the same reason the friends list itself isn't: keeps identity out
    // of git regardless of repo visibility.
    function isAdmin() {
      return isFriend() &&
        get(/databases/$(database)/documents/friends/$(request.auth.token.email)).data.isAdmin == true;
    }

    // Friend directory: readable by any friend (to show names/avatars).
    // Writable only by an admin — normally through the "approve a request"
    // flow in the app, though hand-editing in the console still works too.
    //
    // "get" and "list" are split on purpose: a signed-in user must always
    // be able to check THEIR OWN doc (get), even if they're not a friend —
    // that's how the app tells "not on the list yet" apart from "not
    // signed in". If this only allowed isFriend(), checking your own doc
    // would be denied outright for a real non-friend, and the app could
    // never show that state (it would just look like a generic error).
    // Listing the whole collection (to build the crew roster) stays
    // friends-only so a non-friend can't enumerate the crew.
    match /friends/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isFriend());
      allow list: if isFriend();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Live profile info (display name, a small avatar image) — separate
    // from `friends` (the allowlist, admin-managed) on purpose. Any friend
    // can read anyone's profile (to render "who did this"); you can only
    // ever write your own. This is what makes a renamed friend show up
    // correctly on their OLD votes/notes/RSVPs, not just new ones — those
    // still carry a frozen name/photo from when they were written, but
    // every render prefers the live profile here when one exists.
    match /users/{uid} {
      allow read: if isFriend();
      allow write: if isFriend() && uid == request.auth.uid;
    }

    // A friend request: anyone signed in (not just existing friends) can
    // create their OWN request (doc ID = their uid), so a not-yet-friend
    // can ask for access without needing access to anything else first.
    // Only an admin can list/browse all requests; a requester can still
    // check/cancel their own by ID.
    match /joinRequests/{uid} {
      // create AND update share the same condition on purpose: Firestore
      // treats a client's .set() as an "update" whenever the doc already
      // exists (regardless of set() vs update()), so without this a second
      // click (or a retried write after a network blip) would be denied
      // instead of harmlessly upserting the same request.
      allow create, update: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow get: if request.auth != null && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow delete: if request.auth != null && (uid == request.auth.uid || isAdmin());
    }

    // Editing a game's details (title, Steam link, price, ...) and voting
    // stay open to any friend — that's what lets someone else fix a bad
    // Steam ID, and voting is inherently something every friend does for
    // themselves. Withdrawing/archiving/demoting a game is different: it
    // undoes someone else's proposal outright, so those require the
    // proposer or an admin. This function recognizes an update as one of
    // those specifically by its *result* rather than by field name
    // (archiving always ends in status "archived"; demoting is always
    // "approved" -> "proposed" or "proposed" -> "watchlist") — a friend's
    // own vote never produces any of those transitions (voting only ever
    // moves a game from "proposed" to "approved"), so this can't
    // accidentally catch voting or an ordinary detail edit (which never
    // changes status at all). Promoting FROM Watchlist ("watchlist" ->
    // "proposed") is deliberately NOT included here — like proposing a
    // brand-new game, that's a forward/additive action open to any friend,
    // not one that undoes someone else's work.
    function isGameArchiveOrDemote() {
      return request.resource.data.status == 'archived' ||
        (resource.data.status == 'approved' && request.resource.data.status == 'proposed') ||
        (resource.data.status == 'proposed' && request.resource.data.status == 'watchlist');
    }

    match /games/{gameId} {
      allow read, create: if isFriend();
      allow update: if isFriend() && (
        !isGameArchiveOrDemote() ||
        request.auth.uid == resource.data.proposedBy.uid ||
        isAdmin()
      );
      // Withdrawing (deleting the doc outright) is only ever proposed by
      // the same "undoes someone else's proposal" logic above.
      allow delete: if isFriend() && (request.auth.uid == resource.data.proposedBy.uid || isAdmin());

      // Milestones/todos/notes stay fully open — see MEMORY / conversation:
      // these are meant to be a shared, collaborative checklist, not
      // owned by whoever happened to add an item.
      match /milestones/{milestoneId} {
        allow read, write: if isFriend();
      }
      match /todos/{todoId} {
        allow read, write: if isFriend();
      }
      match /notes/{noteId} {
        allow read, write: if isFriend();
      }
    }

    match /sessions/{sessionId} {
      allow read, create: if isFriend();
      // RSVPing and editing the date/time/notes stay open to any friend;
      // only cancelling (the one update that sets status to "cancelled")
      // requires the proposer or an admin, same reasoning as games above.
      allow update: if isFriend() && (
        request.resource.data.status != 'cancelled' ||
        request.auth.uid == resource.data.proposedBy.uid ||
        isAdmin()
      );
      allow delete: if isFriend() && (request.auth.uid == resource.data.proposedBy.uid || isAdmin());
    }

    // "I'm away Aug 10-17" entries on the Calendar page. Unlike games/
    // sessions/todos (shared, group-owned items anyone in the crew can
    // edit), this is a personal statement about one person's own time —
    // any friend can read the full calendar of who's away, but only the
    // entry's own creator (or an admin, for cleanup) can change or remove
    // it. request.resource.data.uid must match the signed-in user on
    // create, so no one can create an entry claiming to be someone else's.
    match /unavailability/{entryId} {
      allow read: if isFriend();
      allow create: if isFriend() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isFriend() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
