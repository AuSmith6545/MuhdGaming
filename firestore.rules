rules_version = '2';

// The friend allowlist itself lives in Firestore's `friends` collection
// (doc ID = the friend's email), NOT in this file — so no one's email
// address ever ends up in git, public repo or not. Manage that collection
// by hand in Firebase Console -> Firestore Database -> Data tab.
//
// Whenever you change the rules below, copy/paste this whole file into:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function isFriend() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/friends/$(request.auth.token.email));
    }

    // An admin is just a friend doc with isAdmin: true — set by hand in the
    // console (on your own doc: Firestore Database -> Data -> friends ->
    // your email -> add field isAdmin (boolean) = true). Not hardcoded here,
    // for the same reason the friends list itself isn't: keeps identity out
    // of git regardless of repo visibility.
    function isAdmin() {
      return isFriend() &&
        get(/databases/$(database)/documents/friends/$(request.auth.token.email)).data.isAdmin == true;
    }

    // Friend directory: readable by any friend (to show names/avatars).
    // Writable only by an admin — normally through the "approve a request"
    // flow in the app, though hand-editing in the console still works too.
    //
    // "get" and "list" are split on purpose: a signed-in user must always
    // be able to check THEIR OWN doc (get), even if they're not a friend —
    // that's how the app tells "not on the list yet" apart from "not
    // signed in". If this only allowed isFriend(), checking your own doc
    // would be denied outright for a real non-friend, and the app could
    // never show that state (it would just look like a generic error).
    // Listing the whole collection (to build the crew roster) stays
    // friends-only so a non-friend can't enumerate the crew.
    match /friends/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isFriend());
      allow list: if isFriend();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // A friend request: anyone signed in (not just existing friends) can
    // create their OWN request (doc ID = their uid), so a not-yet-friend
    // can ask for access without needing access to anything else first.
    // Only an admin can list/browse all requests; a requester can still
    // check/cancel their own by ID.
    match /joinRequests/{uid} {
      // create AND update share the same condition on purpose: Firestore
      // treats a client's .set() as an "update" whenever the doc already
      // exists (regardless of set() vs update()), so without this a second
      // click (or a retried write after a network blip) would be denied
      // instead of harmlessly upserting the same request.
      allow create, update: if request.auth != null
        && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow get: if request.auth != null && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow delete: if request.auth != null && (uid == request.auth.uid || isAdmin());
    }

    match /games/{gameId} {
      allow read, write: if isFriend();

      match /milestones/{milestoneId} {
        allow read, write: if isFriend();
      }
      match /todos/{todoId} {
        allow read, write: if isFriend();
      }
      match /notes/{noteId} {
        allow read, write: if isFriend();
      }
    }

    match /sessions/{sessionId} {
      allow read, write: if isFriend();
    }
  }
}
