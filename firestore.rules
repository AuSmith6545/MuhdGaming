rules_version = '2';

// The friend allowlist itself lives in Firestore's `friends` collection
// (doc ID = the friend's email), NOT in this file — so no one's email
// address ever ends up in git, public repo or not. Manage that collection
// by hand in Firebase Console -> Firestore Database -> Data tab.
//
// Whenever you change the rules below, copy/paste this whole file into:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function isFriend() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/friends/$(request.auth.token.email));
    }

    // Friend directory: readable by any friend (to show names/avatars),
    // but never writable from the app itself — add/remove friends by
    // hand in the console.
    //
    // "get" and "list" are split on purpose: a signed-in user must always
    // be able to check THEIR OWN doc (get), even if they're not a friend —
    // that's how the app tells "not on the list yet" apart from "not
    // signed in". If this only allowed isFriend(), checking your own doc
    // would be denied outright for a real non-friend, and the app could
    // never show that state (it would just look like a generic error).
    // Listing the whole collection (to build the crew roster) stays
    // friends-only so a non-friend can't enumerate the crew.
    match /friends/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isFriend());
      allow list: if isFriend();
      allow write: if false;
    }

    match /games/{gameId} {
      allow read, write: if isFriend();

      match /milestones/{milestoneId} {
        allow read, write: if isFriend();
      }
      match /todos/{todoId} {
        allow read, write: if isFriend();
      }
      match /notes/{noteId} {
        allow read, write: if isFriend();
      }
    }

    match /sessions/{sessionId} {
      allow read, write: if isFriend();
    }
  }
}
